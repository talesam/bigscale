# Settings for the docker-compose.yml in this folder (build from source).
# For a server, start from examples/caddy/ instead.

# Public address clients use — required on first start.
BIGSCALE_PUBLIC_URL=http://localhost:18080

# Panel served over HTTPS? Mark the session cookie Secure.
# COOKIE_SECURE=true

# Initial admin account. Without ADMIN_PASSWORD a random password is
# generated and printed in the container log on first start.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
